{
  "name": "dsh-comfy-enhance",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "ComfyUI enhance: sidebar status card, output album and bounding-box canvas in one bundle.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "canvas-host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "templates/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
